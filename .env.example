# GEMINI_API_KEY: Required for live Gemini analysis with Search Grounding.
# Without this set (or left as the placeholder below), the server falls back
# to a clearly-labeled offline simulation engine.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (used for self-referential links).
APP_URL="MY_APP_URL"

# NODE_ENV: set to "production" to serve the built dist/ bundle instead of
# running the Vite dev middleware.
NODE_ENV="development"
