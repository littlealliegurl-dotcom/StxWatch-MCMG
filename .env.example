# ANTHROPIC_API_KEY: Required for live IESE analysis. Without it (or left as the
# placeholder below), both the web app and the nightly scorer fall back to a
# clearly-labeled offline simulation engine.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# AIRTABLE_PAT: Persistence for scored records. Needs data.records:read and
# data.records:write, with access to the SCORES base.
AIRTABLE_PAT="MY_AIRTABLE_PAT"

# APP_URL: The URL where this app is hosted (used for self-referential links).
APP_URL="MY_APP_URL"

# NODE_ENV: set to "production" to serve the built dist/ bundle instead of
# running the Vite dev middleware.
NODE_ENV="development"
